index 0000000..a3751e9
--- /dev/null
+++ b/experiments/research161/README.md
@@ -0,0 +1,36 @@
+# Dictionary sampling screen (#161)
+
+This isolated POC writes complete Format v2 fat artifacts and compares their actual byte counts. It does not change production packing, formats, launchers or defaults. The candidates are no dictionary, the current trainer, balanced per-variant history, exact-window deduplication, frequency/prevalence ordering, alternating core/accessory history, and ELF-section sampling. No superstring algorithm or specialist dictionary pool is implemented.
+
+All history alternatives except section sampling keep the **same training contents** and change only dictionary history. This separates the prefix-history question from training-statistics changes. Frequency sorts exact windows by distinct-variant prevalence and then occurrence count. Core means present byte-for-byte in every variant; core/accessory alternates one unique core and one unique accessory window, then fills from the remaining group. When every window is unique, prevalence provides little information; the report records that negative diagnostic. Exact hash buckets are followed by byte comparison.
+
+Uniform sampling reproduces the current 32 evenly spaced 4 KiB windows per variant. Section sampling cycles through file-backed ELF `PROGBITS` sections at least 4 KiB long, selecting 32 4 KiB windows per file. At most eight variants and 64 MiB per input are allowed, so the sample budget stays below the production 4 MiB ceiling. Each requested history budget is capped at one quarter of actual sample bytes, as in the production trainer. Zstd dictionary headers are additional bytes; the reported complete artifact includes them, every frame, the launcher, the exact serialized index and the trailer.
+
+Run with Go 1.27.3 and pinned Task:
+
+```bash
+GOMAXPROCS=2 GOFLAGS=-p=2 task research-161 \
+  MANIFEST=/absolute/path/corpus/manifest.json FAMILY=demo \
+  STUB=/absolute/path/microfat-stub OUTPUT=.work/research161-demo \
+  SIZES=32768,114688 LEVEL=better
+```
+
+`OUTPUT` must be a new directory with an existing parent. It receives a `report.json` and one executable `.fat` per successful candidate. Inputs are read once, hashes and lengths are checked against the manifest, ELF class/endianness/architecture are checked, and immutable in-memory snapshots feed every candidate. The experiment does not execute input or output binaries. Use a launcher built for the same target; SHA-256 and full stub size are recorded. The manifest format is:
+
+```json
+{
+  "schema_version": 1,
+  "source_revision": "full source commit",
+  "go_version": "go1.27.3",
+  "variants": [
+    {"family": "demo", "level": "v1", "path": "/absolute/demo-v1", "sha256": "full hash", "bytes": 123456},
+    {"family": "demo", "level": "v2", "path": "/absolute/demo-v2", "sha256": "full hash", "bytes": 123456}
+  ]
+}
+```
+
+Retain the manifest, exact source/build recipe (including strip flags, architecture tiers and toolchain), and output together. Reports retain every attempted candidate and error. Successful candidates require byte-for-byte decompression **and** the expected SHA-256, followed by the production complete-artifact verifier. The smallest candidate is only a size winner for this bundle; no dictionary remains eligible. The index creation timestamp is fixed at zero to make artifacts deterministic across reruns at the same dependency/toolchain/settings. Timing fields naturally vary.
+
+The one-shot train/assembly wall duration includes compression and round-trip checks but excludes input I/O, complete-artifact verification and file publication. Allocation counters are process-wide Go allocations during that interval, **not peak RSS**. Per-variant compression and decompression durations are codec diagnostics in one process. They do not establish cold process latency, independent samples, application readiness, p99, CPU usage, cgroup behavior or production pack memory. Run timing experiments serially and retain resource controls. Warm verified-cache launches skip decompression, so they remain a negative control for any subsequent launch study.
+
+This is a first screen on supplied families, with no fitted heuristic tuning. Before promotion, predeclare a meaningful complete-byte threshold and pack/startup/memory ceilings, pin separate stripped/unstripped families and toolchains, and confirm on held-out whole program families. Stop selection complexity if the current trainer or no dictionary is equally good. Follow-up startup work must use independently sampled launches, preserve all failures, and keep explicit memfd, auto cache miss, warm verified cache and cold cache materialization separate. Descriptor hashes, size bounds and sealing remain mandatory.
diff --git a/experiments/research161/experiment.go b/experiments/research161/experiment.go
new file mode 100644
index 0000000..cbdb7de
--- /dev/null
+++ b/experiments/research161/experiment.go
@@ -0,0 +1,172 @@
+package main
+
+import (
+	"bytes"
+	"fmt"
+	"runtime"
+	"time"
+
+	"github.com/EpicBlackWolfZ/microfat/internal/codec"
+	"github.com/EpicBlackWolfZ/microfat/internal/format"
+	"github.com/EpicBlackWolfZ/microfat/internal/pack"
+	"github.com/klauspost/compress/zstd"
+)
+
+type payloadResult struct {
+	Level      string `json:"level"`
+	Bytes      int    `json:"compressed_bytes"`
+	CompressNS int64  `json:"compress_wall_ns_diagnostic"`
+	DecodeNS   int64  `json:"decode_wall_ns_diagnostic"`
+	Verified   bool   `json:"byte_exact_and_sha256_verified"`
+}
+
+type result struct {
+	ID               string          `json:"id"`
+	HistoryBudget    int             `json:"history_budget_bytes"`
+	SampleBytes      int             `json:"sample_bytes"`
+	SampleCount      int             `json:"sample_count"`
+	UniqueSamples    int             `json:"unique_sample_count"`
+	CoreSamples      int             `json:"core_sample_count"`
+	HistoryBytes     int             `json:"history_bytes"`
+	HistorySHA256    string          `json:"history_sha256"`
+	DictionaryBytes  int             `json:"dictionary_bytes"`
+	DictionarySHA256 string          `json:"dictionary_sha256"`
+	TrainNS          int64           `json:"train_wall_ns_diagnostic"`
+	EncodeNS         int64           `json:"train_and_assemble_wall_ns_diagnostic"`
+	AllocatedBytes   uint64          `json:"train_and_assemble_allocated_bytes_diagnostic"`
+	Payloads         []payloadResult `json:"payloads"`
+	MetadataBytes    int             `json:"index_and_trailer_bytes"`
+	ArtifactBytes    int             `json:"artifact_bytes"`
+	ArtifactSHA256   string          `json:"artifact_sha256"`
+	ArtifactVerified bool            `json:"artifact_verified"`
+	Error            string          `json:"error,omitempty"`
+}
+
+func train(c candidate, level string) ([]byte, result, error) {
+	res := result{ID: candidateID(c), HistoryBudget: c.size, SampleCount: len(c.samples)}
+	if c.policy == "none" {
+		return nil, res, nil
+	}
+	history, total := selectedHistory(c)
+	res.SampleBytes, res.HistoryBytes, res.HistorySHA256 = total, len(history), digest(history)
+	unique := motifs(c.samples)
+	res.UniqueSamples = len(unique)
+	variants := make(map[int]bool)
+	for _, item := range c.samples {
+		variants[item.variant] = true
+	}
+	for _, item := range unique {
+		if len(item.variants) == len(variants) {
+			res.CoreSamples++
+		}
+	}
+	contents := make([][]byte, 0, len(c.samples))
+	for _, item := range c.samples {
+		contents = append(contents, item.data)
+	}
+	start := time.Now()
+	var dictionary []byte
+	var err error
+	if c.policy == "current" {
+		dictionary, err = codec.TrainDictionary(contents, c.size, level)
+	} else {
+		encLevel, mapErr := codec.NewZstdCodec().MapLevel(level)
+		if mapErr != nil {
+			return nil, res, mapErr
+		}
+		dictionary, err = zstd.BuildDict(zstd.BuildDictOptions{
+			ID: codec.DefaultDictionaryID, History: history, Contents: contents, Level: encLevel,
+		})
+	}
+	res.TrainNS = time.Since(start).Nanoseconds()
+	res.DictionaryBytes, res.DictionarySHA256 = len(dictionary), digest(dictionary)
+	return dictionary, res, err
+}
+
+func evaluate(c candidate, inputs []input, stub []byte, opts options) (result, []byte) {
+	var before, after runtime.MemStats
+	runtime.ReadMemStats(&before)
+	start := time.Now()
+	dictionary, res, err := train(c, opts.level)
+	if err != nil {
+		res.Error = err.Error()
+		return res, nil
+	}
+	artifact, err := assemble(inputs, stub, dictionary, opts, &res)
+	res.EncodeNS = time.Since(start).Nanoseconds()
+	runtime.ReadMemStats(&after)
+	res.AllocatedBytes = after.TotalAlloc - before.TotalAlloc
+	if err != nil {
+		res.Error = err.Error()
+		return res, nil
+	}
+	_, checks, err := pack.VerifyBinary(bytes.NewReader(artifact), int64(len(artifact)))
+	if err != nil {
+		res.Error = fmt.Sprintf("complete artifact verification: %v", err)
+		return res, nil
+	}
+	for _, check := range checks {
+		if !check.Valid {
+			res.Error = fmt.Sprintf("complete artifact variant %s: %s", check.Level, check.ErrorString)
+			return res, nil
+		}
+	}
+	res.ArtifactBytes, res.ArtifactSHA256, res.ArtifactVerified = len(artifact), digest(artifact), true
+	return res, artifact
+}
+
+func assemble(inputs []input, stub, dictionary []byte, opts options, res *result) ([]byte, error) {
+	var artifact bytes.Buffer
+	artifact.Write(stub)
+	idx := &format.Index{
+		Version: format.FormatVersion2, AppName: "research161", TargetOS: "linux", TargetArch: opts.arch,
+	}
+	if len(dictionary) > 0 {
+		idx.DictionaryOffset = int64(artifact.Len())
+		idx.DictionarySize = int64(len(dictionary))
+		idx.DictionarySHA256 = digest(dictionary)
+		idx.DictionaryID = codec.DefaultDictionaryID
+		artifact.Write(dictionary)
+	}
+	zcodec := codec.NewZstdCodec()
+	for _, item := range inputs {
+		payload, diagnostics, err := compressAndVerify(zcodec, item, dictionary, opts.level)
+		res.Payloads = append(res.Payloads, diagnostics)
+		if err != nil {
+			return nil, err
+		}
+		idx.Variants = append(idx.Variants, format.VariantEntry{
+			Level: item.Level, Offset: int64(artifact.Len()), CompressedSize: int64(len(payload)),
+			UncompressedSize: int64(len(item.data)), SHA256: item.SHA256, Compression: codec.AlgorithmZstd,
+		})
+		artifact.Write(payload)
+	}
+	metadataBytes, err := format.WriteIndexAndTrailer(&artifact, idx, int64(artifact.Len()))
+	if err != nil {
+		return nil, err
+	}
+	res.MetadataBytes = int(metadataBytes)
+	return artifact.Bytes(), nil
+}
+
+func compressAndVerify(zcodec *codec.ZstdCodec, item input, dictionary []byte, level string) ([]byte, payloadResult, error) {
+	res := payloadResult{Level: item.Level}
+	var compressed bytes.Buffer
+	start := time.Now()
+	if err := zcodec.CompressWithDict(&compressed, item.data, level, dictionary); err != nil {
+		return nil, res, err
+	}
+	res.CompressNS = time.Since(start).Nanoseconds()
+	res.Bytes = compressed.Len()
+	var decoded bytes.Buffer
+	start = time.Now()
+	if err := zcodec.DecompressWithDict(&decoded, bytes.NewReader(compressed.Bytes()), int64(len(item.data)), dictionary); err != nil {
+		return nil, res, err
+	}
+	res.DecodeNS = time.Since(start).Nanoseconds()
+	if !bytes.Equal(item.data, decoded.Bytes()) || digest(decoded.Bytes()) != item.SHA256 {
+		return nil, res, fmt.Errorf("variant %s failed exact round trip", item.Level)
+	}
+	res.Verified = true
+	return compressed.Bytes(), res, nil
+}
diff --git a/experiments/research161/main.go b/experiments/research161/main.go
new file mode 100644
index 0000000..79461dc
--- /dev/null
+++ b/experiments/research161/main.go
@@ -0,0 +1,279 @@
+// Command research161 screens bounded dictionary sampling alternatives for issue #161.
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"runtime"
+	"runtime/debug"
+	"slices"
+	"strconv"
+	"strings"
+
+	"github.com/EpicBlackWolfZ/microfat/internal/codec"
+	"github.com/EpicBlackWolfZ/microfat/internal/microarch"
+)
+
+const (
+	maxInputBytes = 64 * 1024 * 1024
+	maxVariants   = 8
+	minVariants   = 2
+	defaultSizes  = "32768,114688"
+	privateDir    = 0o700
+	privateFile   = 0o600
+	issueNumber   = 161
+)
+
+type input struct {
+	Family string `json:"family"`
+	Level  string `json:"level"`
+	Path   string `json:"path"`
+	SHA256 string `json:"sha256"`
+	Bytes  int    `json:"bytes"`
+	data   []byte
+}
+
+type manifest struct {
+	SchemaVersion  int     `json:"schema_version"`
+	SourceRevision string  `json:"source_revision"`
+	GoVersion      string  `json:"go_version"`
+	Variants       []input `json:"variants"`
+}
+
+type options struct {
+	manifestPath string
+	family       string
+	stubPath     string
+	output       string
+	sizes        string
+	level        string
+	arch         string
+}
+
+type report struct {
+	SchemaVersion  int      `json:"schema_version"`
+	Issue          int      `json:"issue"`
+	ManifestSHA256 string   `json:"manifest_sha256"`
+	SourceRevision string   `json:"source_revision"`
+	CorpusGo       string   `json:"corpus_go_version"`
+	RunnerGo       string   `json:"runner_go_version"`
+	CodecVersion   string   `json:"codec_version"`
+	Family         string   `json:"family"`
+	TargetArch     string   `json:"target_arch"`
+	Level          string   `json:"compression_level"`
+	GOMAXPROCS     int      `json:"gomaxprocs"`
+	StubSHA256     string   `json:"stub_sha256"`
+	StubBytes      int      `json:"stub_bytes"`
+	Inputs         []input  `json:"inputs"`
+	Results        []result `json:"results"`
+	Smallest       string   `json:"smallest_verified_artifact"`
+	Limitations    []string `json:"limitations"`
+}
+
+func main() {
+	if err := run(os.Args[1:], os.Stderr); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func parseOptions(args []string, stderr io.Writer) (options, error) {
+	var opts options
+	flags := flag.NewFlagSet("research161", flag.ContinueOnError)
+	flags.SetOutput(stderr)
+	flags.StringVar(&opts.manifestPath, "manifest", "", "pinned corpus manifest JSON")
+	flags.StringVar(&opts.family, "family", "", "one corpus program family")
+	flags.StringVar(&opts.stubPath, "stub", "", "matching microfat stub ELF")
+	flags.StringVar(&opts.output, "output", "", "new output directory (never overwritten)")
+	flags.StringVar(&opts.sizes, "sizes", defaultSizes, "comma-separated history byte budgets")
+	flags.StringVar(&opts.level, "level", "better", "fixed Zstd compression level")
+	flags.StringVar(&opts.arch, "arch", runtime.GOARCH, "target ELF architecture")
+	if err := flags.Parse(args); err != nil {
+		return opts, err
+	}
+	if flags.NArg() != 0 || opts.manifestPath == "" || opts.family == "" || opts.stubPath == "" || opts.output == "" {
+		return opts, errors.New("--manifest, --family, --stub and --output are required; positional arguments are unsupported")
+	}
+	if _, err := codec.NewZstdCodec().MapLevel(opts.level); err != nil {
+		return opts, err
+	}
+	return opts, nil
+}
+
+func parseSizes(value string) ([]int, error) {
+	var sizes []int
+	for _, part := range strings.Split(value, ",") {
+		size, err := strconv.Atoi(part)
+		if err != nil || size < sampleBytes || size > codec.MaxDictSize {
+			return nil, fmt.Errorf("invalid history budget %q: require %d..%d bytes", part, sampleBytes, codec.MaxDictSize)
+		}
+		if slices.Contains(sizes, size) {
+			return nil, fmt.Errorf("duplicate history budget %d", size)
+		}
+		sizes = append(sizes, size)
+	}
+	return sizes, nil
+}
+
+func readBounded(path string) ([]byte, error) {
+	f, err := os.Open(path) // #nosec G304 -- Explicit user-selected corpus input; size and file type are bounded below.
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = f.Close() }()
+	info, err := f.Stat()
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() || info.Size() > maxInputBytes {
+		return nil, errors.New("input must be a regular file at most 64 MiB")
+	}
+	data, err := io.ReadAll(io.LimitReader(f, maxInputBytes+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(data) > maxInputBytes {
+		return nil, errors.New("input exceeded 64 MiB while reading")
+	}
+	return data, nil
+}
+
+func loadCorpus(opts options) (manifest, []input, string, error) {
+	data, err := readBounded(opts.manifestPath)
+	if err != nil {
+		return manifest{}, nil, "", err
+	}
+	var corpus manifest
+	if err := json.Unmarshal(data, &corpus); err != nil {
+		return corpus, nil, "", err
+	}
+	if corpus.SchemaVersion != 1 || corpus.SourceRevision == "" || corpus.GoVersion != "go1.27.3" {
+		return corpus, nil, "", errors.New("require schema_version=1, source_revision and pinned corpus go_version=go1.27.3")
+	}
+	var selected []input
+	seen := make(map[string]bool)
+	for _, item := range corpus.Variants {
+		if item.Family != opts.family {
+			continue
+		}
+		if strings.TrimSpace(item.Level) == "" {
+			return corpus, nil, "", errors.New("variant level is required")
+		}
+		item.Level = microarch.Normalize(item.Level)
+		if seen[item.Level] || microarch.Rank(opts.arch, item.Level) < 0 {
+			return corpus, nil, "", fmt.Errorf("duplicate or invalid variant level %q", item.Level)
+		}
+		seen[item.Level] = true
+		item.data, err = readBounded(item.Path)
+		if err != nil {
+			return corpus, nil, "", err
+		}
+		if item.Bytes != len(item.data) || item.SHA256 != digest(item.data) {
+			return corpus, nil, "", fmt.Errorf("corpus identity mismatch: %s", item.Path)
+		}
+		if err := validateELF(item.data, opts.arch); err != nil {
+			return corpus, nil, "", fmt.Errorf("variant %s: %w", item.Level, err)
+		}
+		selected = append(selected, item)
+	}
+	if len(selected) < minVariants || len(selected) > maxVariants {
+		return corpus, nil, "", errors.New("select between two and eight variants from one family")
+	}
+	slices.SortFunc(selected, func(a, b input) int {
+		return microarch.Rank(opts.arch, a.Level) - microarch.Rank(opts.arch, b.Level)
+	})
+	return corpus, selected, digest(data), nil
+}
+
+func run(args []string, stderr io.Writer) error {
+	opts, err := parseOptions(args, stderr)
+	if err != nil {
+		return err
+	}
+	sizes, err := parseSizes(opts.sizes)
+	if err != nil {
+		return err
+	}
+	corpus, inputs, manifestHash, err := loadCorpus(opts)
+	if err != nil {
+		return err
+	}
+	stub, err := readBounded(opts.stubPath)
+	if err != nil {
+		return err
+	}
+	if err := validateELF(stub, opts.arch); err != nil {
+		return fmt.Errorf("stub: %w", err)
+	}
+	if err := os.Mkdir(opts.output, privateDir); err != nil {
+		return err
+	}
+	rep := report{
+		SchemaVersion: 1, Issue: issueNumber, ManifestSHA256: manifestHash, SourceRevision: corpus.SourceRevision,
+		CorpusGo: corpus.GoVersion, RunnerGo: runtime.Version(), CodecVersion: codecVersion(), Family: opts.family,
+		TargetArch: opts.arch, Level: opts.level, GOMAXPROCS: runtime.GOMAXPROCS(0), StubSHA256: digest(stub),
+		StubBytes: len(stub), Inputs: inputs,
+		Limitations: []string{
+			"A bounded in-memory size screen; all inputs and complete artifacts are retained in memory.",
+			"Wall time and allocation counters are one-shot diagnostics, excluding input I/O and publication; they are not process-start p99.",
+			"No peak RSS, pack CPU, cgroup stress, launch execution, held-out validation or production-default decision is claimed.",
+			"Requested history budgets match; actual history is capped at one quarter of training bytes. Dictionary headers add bytes.",
+			"Section sampling changes training contents; other alternatives isolate history selection with uniform contents.",
+			"No dictionary is a required candidate. Warm verified-cache launches do not decompress.",
+		},
+	}
+	for _, candidate := range candidates(inputs, sizes) {
+		res, artifact := evaluate(candidate, inputs, stub, opts)
+		if res.Error == "" {
+			if err := os.WriteFile(filepath.Join(opts.output, res.ID+".fat"), artifact, privateDir); err != nil {
+				return err
+			}
+		}
+		rep.Results = append(rep.Results, res)
+	}
+	rep.Smallest = smallest(rep.Results)
+	if rep.Smallest == "" {
+		return errors.New("all candidates failed; output directory retained for inspection")
+	}
+	data, err := json.MarshalIndent(rep, "", "  ")
+	if err != nil {
+		return err
+	}
+	return os.WriteFile(filepath.Join(opts.output, "report.json"), append(data, '\n'), privateFile)
+}
+
+func digest(data []byte) string {
+	hash := sha256.Sum256(data)
+	return hex.EncodeToString(hash[:])
+}
+
+func codecVersion() string {
+	if info, ok := debug.ReadBuildInfo(); ok {
+		for _, dep := range info.Deps {
+			if dep.Path == "github.com/klauspost/compress" {
+				return dep.Version
+			}
+		}
+	}
+	return "unavailable"
+}
+
+func smallest(results []result) string {
+	var best *result
+	for i := range results {
+		if results[i].Error == "" && (best == nil || results[i].ArtifactBytes < best.ArtifactBytes) {
+			best = &results[i]
+		}
+	}
+	if best == nil {
+		return ""
+	}
+	return best.ID
+}
diff --git a/experiments/research161/main_test.go b/experiments/research161/main_test.go
