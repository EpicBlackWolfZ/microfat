index 0000000..be6a7cf
--- /dev/null
+++ b/experiments/research161/main_test.go
@@ -0,0 +1,169 @@
+package main
+
+import (
+	"encoding/json"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func corpusFixture(t *testing.T) (options, manifest) {
+	t.Helper()
+	dir := t.TempDir()
+	inputs := fixtureInputs()
+	for i := range inputs {
+		inputs[i].Path = filepath.Join(dir, inputs[i].Level)
+		require.NoError(t, os.WriteFile(inputs[i].Path, inputs[i].data, 0o600))
+	}
+	corpus := manifest{SchemaVersion: 1, SourceRevision: "fixture-source", GoVersion: "go1.27.3", Variants: inputs}
+	path := filepath.Join(dir, "manifest.json")
+	data, err := json.Marshal(corpus)
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(path, data, 0o600))
+	return options{manifestPath: path, family: "test", arch: "amd64", stubPath: inputs[0].Path,
+		output: filepath.Join(dir, "out"), sizes: "4096", level: "fastest"}, corpus
+}
+
+func cliArgs(opts options) []string {
+	return []string{"--manifest", opts.manifestPath, "--family", opts.family, "--stub", opts.stubPath,
+		"--output", opts.output, "--sizes", opts.sizes, "--level", opts.level, "--arch", opts.arch}
+}
+
+func TestCLIAndCorpus(t *testing.T) {
+	opts, _ := corpusFixture(t)
+	parsed, err := parseOptions(cliArgs(opts), io.Discard)
+	require.NoError(t, err)
+	assert.Equal(t, opts, parsed)
+	for _, args := range [][]string{nil, {"--unknown"}, append(cliArgs(opts), "extra"), {"--level", "invalid"}} {
+		_, err := parseOptions(args, io.Discard)
+		require.Error(t, err)
+	}
+	args := cliArgs(opts)
+	args = append(args, "--level", "invalid")
+	_, err = parseOptions(args, io.Discard)
+	require.Error(t, err)
+	for _, sizes := range []string{"", "no", "1", "4096,4096", "99999999"} {
+		_, err := parseSizes(sizes)
+		require.Error(t, err)
+	}
+	sizes, err := parseSizes(defaultSizes)
+	require.NoError(t, err)
+	assert.Equal(t, []int{32768, 114688}, sizes)
+	corpus, inputs, hash, err := loadCorpus(opts)
+	require.NoError(t, err)
+	assert.Equal(t, "fixture-source", corpus.SourceRevision)
+	require.Len(t, inputs, 2)
+	assert.Len(t, hash, 64)
+	assert.Equal(t, "v1", inputs[0].Level)
+	require.NoError(t, run(cliArgs(opts), io.Discard))
+	data, err := os.ReadFile(filepath.Join(opts.output, "report.json"))
+	require.NoError(t, err)
+	var rep report
+	require.NoError(t, json.Unmarshal(data, &rep))
+	require.Len(t, rep.Results, 7)
+	assert.NotEmpty(t, rep.Smallest)
+	assert.Equal(t, hash, rep.ManifestSHA256)
+	for _, result := range rep.Results {
+		require.Empty(t, result.Error)
+		artifact, err := os.ReadFile(filepath.Join(opts.output, result.ID+".fat"))
+		require.NoError(t, err)
+		assert.Equal(t, result.ArtifactSHA256, digest(artifact))
+	}
+	require.Error(t, run(cliArgs(opts), io.Discard), "existing output must not be overwritten")
+	assert.NotEmpty(t, codecVersion())
+}
+
+func TestMainSuccess(t *testing.T) {
+	opts, corpus := corpusFixture(t)
+	corpus.Variants = append(corpus.Variants, input{Family: "other-family", Path: "ignored"})
+	data, err := json.Marshal(corpus)
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(opts.manifestPath, data, privateFile))
+	previous := os.Args
+	os.Args = append([]string{"research161"}, cliArgs(opts)...)
+	t.Cleanup(func() { os.Args = previous })
+	main()
+	_, err = os.Stat(filepath.Join(opts.output, "report.json"))
+	require.NoError(t, err)
+}
+
+func TestManifestFailures(t *testing.T) {
+	t.Parallel()
+	cases := []struct {
+		name   string
+		mutate func(*manifest)
+	}{
+		{"schema", func(m *manifest) { m.SchemaVersion = 2 }},
+		{"go version", func(m *manifest) { m.GoVersion = "go1.26.0" }},
+		{"revision", func(m *manifest) { m.SourceRevision = "" }},
+		{"no family", func(m *manifest) { m.Variants = nil }},
+		{"missing input", func(m *manifest) { m.Variants[0].Path += "-missing" }},
+		{"duplicate", func(m *manifest) { m.Variants[1].Level = "AMD64_V1" }},
+		{"unknown level", func(m *manifest) { m.Variants[1].Level = "v0" }},
+		{"empty level", func(m *manifest) { m.Variants[1].Level = "" }},
+		{"hash", func(m *manifest) { m.Variants[0].SHA256 = "wrong" }},
+		{"bytes", func(m *manifest) { m.Variants[0].Bytes++ }},
+		{"invalid elf", func(m *manifest) {
+			m.Variants[0].data = []byte("invalid")
+			m.Variants[0].Bytes = len(m.Variants[0].data)
+			m.Variants[0].SHA256 = digest(m.Variants[0].data)
+		}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			opts, corpus := corpusFixture(t)
+			tc.mutate(&corpus)
+			for _, item := range corpus.Variants {
+				if item.data != nil && item.Path != "" && tc.name == "invalid elf" {
+					require.NoError(t, os.WriteFile(item.Path, item.data, 0o600))
+				}
+			}
+			data, err := json.Marshal(corpus)
+			require.NoError(t, err)
+			require.NoError(t, os.WriteFile(opts.manifestPath, data, 0o600))
+			_, _, _, err = loadCorpus(opts)
+			require.Error(t, err)
+		})
+	}
+	for _, content := range []string{"invalid json", "{}"} {
+		opts, _ := corpusFixture(t)
+		require.NoError(t, os.WriteFile(opts.manifestPath, []byte(content), 0o600))
+		_, _, _, err := loadCorpus(opts)
+		require.Error(t, err)
+	}
+	opts, _ := corpusFixture(t)
+	opts.manifestPath += "missing"
+	_, _, _, err := loadCorpus(opts)
+	require.Error(t, err)
+	_, err = readBounded(t.TempDir())
+	require.Error(t, err)
+	_, err = readBounded(filepath.Join(t.TempDir(), "missing"))
+	require.Error(t, err)
+	large := filepath.Join(t.TempDir(), "large")
+	f, err := os.Create(large)
+	require.NoError(t, err)
+	require.NoError(t, f.Truncate(maxInputBytes+1))
+	require.NoError(t, f.Close())
+	_, err = readBounded(large)
+	require.Error(t, err)
+}
+
+func TestRunFailures(t *testing.T) {
+	for _, change := range []func(*options){
+		func(o *options) { o.sizes = "bad" },
+		func(o *options) { o.manifestPath += "missing" },
+		func(o *options) { o.stubPath += "missing" },
+		func(o *options) { o.stubPath = o.manifestPath },
+		func(o *options) { o.output = filepath.Join(o.output, "missing", "out") },
+	} {
+		opts, _ := corpusFixture(t)
+		change(&opts)
+		require.Error(t, run(cliArgs(opts), io.Discard))
+	}
+	require.Error(t, run(nil, io.Discard))
+}
diff --git a/experiments/research161/samples.go b/experiments/research161/samples.go
new file mode 100644
index 0000000..63b5eb7
--- /dev/null
+++ b/experiments/research161/samples.go
@@ -0,0 +1,234 @@
+package main
+
+import (
+	"bytes"
+	"debug/elf"
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+
+	"github.com/EpicBlackWolfZ/microfat/internal/microarch"
+)
+
+const (
+	sampleBytes    = 4 * 1024
+	samplesPerFile = 32
+	historyDivisor = 4
+)
+
+type sample struct {
+	data    []byte
+	variant int
+}
+
+type candidate struct {
+	policy  string
+	size    int
+	samples []sample
+}
+
+func validateELF(data []byte, arch string) error {
+	f, err := elf.NewFile(bytes.NewReader(data))
+	if err != nil {
+		return err
+	}
+	defer func() { _ = f.Close() }()
+	want := elf.EM_X86_64
+	if arch == microarch.ArchARM64 {
+		want = elf.EM_AARCH64
+	} else if arch != microarch.ArchAMD64 {
+		return errors.New("only amd64 and arm64 ELF corpora are supported")
+	}
+	if f.Machine != want || f.Class != elf.ELFCLASS64 || f.Data != elf.ELFDATA2LSB {
+		return fmt.Errorf("ELF must be little-endian 64-bit %s", arch)
+	}
+	return nil
+}
+
+func uniformSamples(inputs []input) []sample {
+	var out []sample
+	for variant, item := range inputs {
+		step := max(len(item.data)/samplesPerFile, sampleBytes)
+		count := 0
+		for offset := 0; offset < len(item.data) && count < samplesPerFile; offset += step {
+			out = append(out, sample{data: item.data[offset:min(offset+sampleBytes, len(item.data))], variant: variant})
+			count++
+		}
+	}
+	return out
+}
+
+// sectionSamples splits the same per-file count across ELF PROGBITS sections.
+// Round-robin sections prevent large .text sections from exhausting every slot.
+func sectionSamples(inputs []input) []sample {
+	var out []sample
+	for variant, item := range inputs {
+		f, err := elf.NewFile(bytes.NewReader(item.data))
+		if err != nil {
+			continue // loadCorpus rejects malformed ELF before candidate generation.
+		}
+		var sections []*elf.Section
+		for _, section := range f.Sections {
+			if section.Type == elf.SHT_PROGBITS && section.Size >= sampleBytes &&
+				section.Size <= maxInputBytes && section.Offset <= maxInputBytes &&
+				section.Offset < uint64(len(item.data)) && section.Size <= uint64(len(item.data))-section.Offset {
+				sections = append(sections, section)
+			}
+		}
+		for round := 0; round < samplesPerFile && len(sections) > 0; round++ {
+			section := sections[round%len(sections)]
+			slots := (samplesPerFile + len(sections) - 1) / len(sections)
+			position := round / len(sections)
+			// Section size and offset were bounded to 64 MiB before entering sections.
+			span := int(section.Size) - sampleBytes // #nosec G115 -- Explicit 64 MiB bound above fits every supported int.
+			start := int(section.Offset)            // #nosec G115 -- Explicit 64 MiB bound above fits every supported int.
+			offset := start + position*max(span/slots, 1)
+			offset = min(offset, start+span)
+			end := offset + sampleBytes
+			out = append(out, sample{data: item.data[offset:end], variant: variant})
+		}
+		_ = f.Close()
+	}
+	return out
+}
+
+func candidates(inputs []input, sizes []int) []candidate {
+	uniform := uniformSamples(inputs)
+	section := sectionSamples(inputs)
+	out := []candidate{{policy: "none"}}
+	for _, size := range sizes {
+		for _, policy := range []string{"current", "balanced", "deduplicated", "frequency", "core-accessory", "section"} {
+			samples := uniform
+			if policy == "section" {
+				samples = section
+			}
+			out = append(out, candidate{policy: policy, size: size, samples: samples})
+		}
+	}
+	return out
+}
+
+func balanced(samples []sample) []sample {
+	result := slices.Clone(samples)
+	// Stable sort by sample ordinal within variant, then by variant.
+	positions := make(map[int]int)
+	type indexed struct {
+		sample
+		position int
+	}
+	ordered := make([]indexed, 0, len(samples))
+	for _, item := range samples {
+		ordered = append(ordered, indexed{sample: item, position: positions[item.variant]})
+		positions[item.variant]++
+	}
+	slices.SortStableFunc(ordered, func(a, b indexed) int {
+		if a.position != b.position {
+			return a.position - b.position
+		}
+		return a.variant - b.variant
+	})
+	for i := range ordered {
+		result[i] = ordered[i].sample
+	}
+	return result
+}
+
+type motif struct {
+	sample
+	variants map[int]bool
+	count    int
+}
+
+func motifs(samples []sample) []motif {
+	var out []motif
+	byDigest := make(map[string][]int)
+	for _, item := range samples {
+		key := digest(item.data)
+		found := false
+		for _, index := range byDigest[key] {
+			if bytes.Equal(out[index].data, item.data) {
+				out[index].variants[item.variant] = true
+				out[index].count++
+				found = true
+				break
+			}
+		}
+		if !found {
+			byDigest[key] = append(byDigest[key], len(out))
+			out = append(out, motif{sample: item, variants: map[int]bool{item.variant: true}, count: 1})
+		}
+	}
+	return out
+}
+
+func selectedHistory(c candidate) ([]byte, int) {
+	total := 0
+	for _, item := range c.samples {
+		total += len(item.data)
+	}
+	limit := max(min(c.size, total/historyDivisor), 8)
+	ordered := c.samples
+	if c.policy == "balanced" || c.policy == "section" {
+		ordered = balanced(ordered)
+	}
+	if c.policy == "deduplicated" || c.policy == "frequency" || c.policy == "core-accessory" {
+		unique := motifs(balanced(c.samples))
+		if c.policy != "deduplicated" {
+			slices.SortStableFunc(unique, func(a, b motif) int {
+				if len(a.variants) != len(b.variants) {
+					return len(b.variants) - len(a.variants)
+				}
+				return b.count - a.count
+			})
+		}
+		ordered = make([]sample, 0, len(unique))
+		if c.policy == "core-accessory" {
+			unique = interleaveCoreAccessory(unique, c.samples)
+		}
+		for _, item := range unique {
+			ordered = append(ordered, item.sample)
+		}
+	}
+	var history []byte
+	for _, item := range ordered {
+		remaining := limit - len(history)
+		if remaining <= 0 {
+			break
+		}
+		history = append(history, item.data[:min(remaining, len(item.data))]...)
+	}
+	return history, total
+}
+
+func interleaveCoreAccessory(unique []motif, samples []sample) []motif {
+	variants := make(map[int]bool)
+	for _, item := range samples {
+		variants[item.variant] = true
+	}
+	var core, accessory []motif
+	for _, item := range unique {
+		if len(item.variants) == len(variants) {
+			core = append(core, item)
+		} else {
+			accessory = append(accessory, item)
+		}
+	}
+	var out []motif
+	for i := 0; i < max(len(core), len(accessory)); i++ {
+		if i < len(core) {
+			out = append(out, core[i])
+		}
+		if i < len(accessory) {
+			out = append(out, accessory[i])
+		}
+	}
+	return out
+}
+
+func candidateID(c candidate) string {
+	if c.policy == "none" {
+		return c.policy
+	}
+	return strings.Join([]string{c.policy, fmt.Sprint(c.size)}, "-")
+}
diff --git a/experiments/research161/samples_test.go b/experiments/research161/samples_test.go
new file mode 100644
index 0000000..d3907bc
--- /dev/null
+++ b/experiments/research161/samples_test.go
@@ -0,0 +1,179 @@
+package main
+
+import (
+	"bytes"
+	"debug/elf"
+	"encoding/binary"
+	"slices"
+	"testing"
+
+	"github.com/EpicBlackWolfZ/microfat/internal/codec"
+	"github.com/EpicBlackWolfZ/microfat/internal/format"
+	"github.com/EpicBlackWolfZ/microfat/internal/pack"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+const fixtureSize = 128 * 1024
+
+func fixtureELF() []byte {
+	const (
+		sectionTable = 64
+		sectionSize  = 64
+		sectionCount = 2
+		bodyOffset   = sectionTable + sectionSize*sectionCount
+	)
+	data := make([]byte, bodyOffset+fixtureSize)
+	copy(data, "\x7fELF")
+	data[elf.EI_CLASS], data[elf.EI_DATA], data[elf.EI_VERSION] = byte(elf.ELFCLASS64), byte(elf.ELFDATA2LSB), 1
+	binary.LittleEndian.PutUint16(data[16:], uint16(elf.ET_EXEC))
+	binary.LittleEndian.PutUint16(data[18:], uint16(elf.EM_X86_64))
+	binary.LittleEndian.PutUint32(data[20:], 1)
+	binary.LittleEndian.PutUint64(data[40:], sectionTable)
+	binary.LittleEndian.PutUint16(data[52:], sectionTable)
+	binary.LittleEndian.PutUint16(data[58:], sectionSize)
+	binary.LittleEndian.PutUint16(data[60:], sectionCount)
+	section := data[sectionTable+sectionSize:]
+	binary.LittleEndian.PutUint32(section[4:], uint32(elf.SHT_PROGBITS))
+	binary.LittleEndian.PutUint64(section[24:], bodyOffset)
+	binary.LittleEndian.PutUint64(section[32:], fixtureSize)
+	for i := bodyOffset; i < len(data); i++ {
+		data[i] = byte((i % 251) ^ (i / 1024))
+	}
+	return data
+}
+
+func fixtureInputs() []input {
+	first := fixtureELF()
+	second := slices.Clone(first)
+	for i := 1024; i < len(second); i += sampleBytes {
+		second[i] ^= 1
+	}
+	return []input{
+		{Family: "test", Level: "v1", data: first, Bytes: len(first), SHA256: digest(first)},
+		{Family: "test", Level: "v2", data: second, Bytes: len(second), SHA256: digest(second)},
+	}
+}
+
+func TestELFAndSampling(t *testing.T) {
+	t.Parallel()
+	inputs := fixtureInputs()
+	require.NoError(t, validateELF(inputs[0].data, "amd64"))
+	require.Error(t, validateELF(inputs[0].data, "arm64"))
+	require.Error(t, validateELF(inputs[0].data, "other"))
+	require.Error(t, validateELF(nil, "amd64"))
+	arm := slices.Clone(inputs[0].data)
+	binary.LittleEndian.PutUint16(arm[18:], uint16(elf.EM_AARCH64))
+	require.NoError(t, validateELF(arm, "arm64"))
+	uniform := uniformSamples(inputs)
+	require.Len(t, uniform, samplesPerFile*len(inputs))
+	assert.Equal(t, inputs[0].data[:sampleBytes], uniform[0].data)
+	step := len(inputs[0].data) / samplesPerFile
+	assert.Equal(t, inputs[0].data[step:step+sampleBytes], uniform[1].data)
+	section := sectionSamples(inputs)
+	require.Len(t, section, samplesPerFile*len(inputs))
+	for _, item := range section {
+		assert.Len(t, item.data, sampleBytes)
+	}
+	assert.Empty(t, sectionSamples([]input{{data: nil}}))
+	assert.Len(t, uniformSamples([]input{{data: []byte("tiny")}}), 1)
+	all := candidates(inputs, []int{sampleBytes})
+	require.Len(t, all, 7)
+	assert.Equal(t, "none", candidateID(all[0]))
+	assert.Equal(t, "current-4096", candidateID(all[1]))
+}
+
+func TestHistoryAblations(t *testing.T) {
+	t.Parallel()
+	block := func(value byte) []byte { return bytes.Repeat([]byte{value}, sampleBytes) }
+	core, accessory, rare := block('c'), block('a'), block('r')
+	samples := []sample{
+		{data: core, variant: 0}, {data: accessory, variant: 0}, {data: rare, variant: 0},
+		{data: core, variant: 1}, {data: accessory, variant: 1}, {data: core, variant: 1},
+	}
+	ordered := balanced(samples)
+	require.Equal(t, []int{0, 1, 0, 1, 0, 1}, []int{
+		ordered[0].variant, ordered[1].variant, ordered[2].variant,
+		ordered[3].variant, ordered[4].variant, ordered[5].variant,
+	})
+	unique := motifs(samples)
+	require.Len(t, unique, 3)
+	assert.Len(t, unique[0].variants, 2)
+	assert.Equal(t, 3, unique[0].count)
+	assert.Equal(t, []byte{'c', 'r', 'a'}, func() []byte {
+		var out []byte
+		for _, item := range interleaveCoreAccessory(unique, samples) {
+			out = append(out, item.data[0])
+		}
+		return out
+	}())
+	for _, policy := range []string{"current", "balanced", "deduplicated", "frequency", "core-accessory", "section"} {
+		t.Run(policy, func(t *testing.T) {
+			t.Parallel()
+			history, total := selectedHistory(candidate{policy: policy, size: sampleBytes, samples: samples})
+			assert.Equal(t, len(samples)*sampleBytes, total)
+			assert.Len(t, history, sampleBytes)
+			assert.Equal(t, core, history)
+		})
+	}
+	// Repeated windows must not displace a later unique motif in deduplicated history.
+	small := []sample{{data: []byte("aaaa"), variant: 0}, {data: []byte("aaaa"), variant: 1},
+		{data: []byte("bbbb"), variant: 1}, {data: []byte("cccc"), variant: 1}}
+	history, _ := selectedHistory(candidate{policy: "deduplicated", size: sampleBytes, samples: small})
+	assert.Equal(t, "aaaabbbb", string(history))
+}
+
+func TestCompleteArtifactCandidates(t *testing.T) {
+	// Serial because the allocation/timing diagnostics intentionally observe the process.
+	inputs := fixtureInputs()
+	stub := fixtureELF()
+	opts := options{arch: "amd64", level: "fastest"}
+	for _, candidate := range candidates(inputs, []int{sampleBytes}) {
+		t.Run(candidateID(candidate), func(t *testing.T) {
+			res, artifact := evaluate(candidate, inputs, stub, opts)
+			require.Empty(t, res.Error)
+			require.True(t, res.ArtifactVerified)
+			require.Len(t, artifact, res.ArtifactBytes)
+			var payloadBytes int
+			for _, item := range res.Payloads {
+				assert.True(t, item.Verified)
+				payloadBytes += item.Bytes
+			}
+			assert.Equal(t, len(stub)+res.DictionaryBytes+payloadBytes+res.MetadataBytes, res.ArtifactBytes)
+			assert.Equal(t, digest(artifact), res.ArtifactSHA256)
+			idx, checks, err := pack.VerifyBinary(bytes.NewReader(artifact), int64(len(artifact)))
+			require.NoError(t, err)
+			require.Len(t, checks, len(inputs))
+			assert.Equal(t, int64(0), idx.CreatedUnix)
+			assert.Equal(t, format.FormatVersion2, idx.Version)
+			_, again := evaluate(candidate, inputs, stub, opts)
+			assert.Equal(t, artifact, again, "same settings produce deterministic complete artifacts")
+			if idx.DictionarySize > 0 {
+				artifact[idx.DictionaryOffset] ^= 1
+				_, _, err = pack.VerifyBinary(bytes.NewReader(artifact), int64(len(artifact)))
+				require.ErrorIs(t, err, format.ErrDictionaryCorrupted)
+			} else {
+				artifact[idx.Variants[0].Offset] ^= 1
+				_, checks, err = pack.VerifyBinary(bytes.NewReader(artifact), int64(len(artifact)))
+				require.NoError(t, err)
+				assert.False(t, checks[0].Valid)
+			}
+		})
+	}
+	_, _, err := train(candidate{policy: "current"}, "better")
+	require.Error(t, err)
+	_, _, err = train(candidate{policy: "balanced", samples: uniformSamples(inputs), size: sampleBytes}, "invalid")
+	require.Error(t, err)
+	bad := inputs[0]
+	bad.SHA256 = "wrong"
+	_, _, err = compressAndVerify(codec.NewZstdCodec(), bad, nil, "fastest")
+	require.ErrorContains(t, err, "exact round trip")
+	_, _, err = compressAndVerify(codec.NewZstdCodec(), inputs[0], nil, "invalid")
+	require.Error(t, err)
+	res, _ := evaluate(candidate{policy: "current"}, inputs, stub, opts)
+	assert.NotEmpty(t, res.Error)
+	res, _ = evaluate(candidate{policy: "none"}, inputs, stub, options{arch: "amd64", level: "invalid"})
+	assert.NotEmpty(t, res.Error)
+	assert.Empty(t, smallest([]result{{ID: "failed", Error: "error"}}))
+	assert.Equal(t, "small", smallest([]result{{ID: "large", ArtifactBytes: 10}, {ID: "small", ArtifactBytes: 1}}))
+}
