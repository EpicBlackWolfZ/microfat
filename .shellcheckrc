# .shellcheckrc
# Modern, strict, and security-focused ShellCheck configuration.

# Treat scripts without an explicit shell directive as Bash.
shell=bash

# Analyze sourced files rather than silently treating them as opaque.
external-sources=true
source-path=SCRIPTDIR

# Strict optional rules.
enable=check-unassigned-uppercase
enable=quote-safe-variables
enable=check-extra-masked-returns
enable=check-set-e-suppressed
enable=require-variable-braces

# Do NOT globally disable SC1090.
#
# Dynamic source paths that ShellCheck cannot resolve must instead use an
# accurate `# shellcheck source=...` directive. A source=/dev/null exemption
# should only be used when intentionally ignoring the sourced file is correct
# and the reason is documented.
